# Courier Memory · ortam değişkenleri örneği
# Kopyalayın:  cp .env.example .env   (.env git'e girmez; içine gizli değer koymayın, kimlik AWS profilinden gelsin)
# Kullanım:    uvicorn api.main:app --env-file .env
#              ya da kabukta:  set -a; source .env; set +a

# ---------------------------------------------------------------- AWS
# Kimlik standart AWS zincirinden gelir (profil, SSO, instance rolü). Anahtarı buraya yazmayın.
AWS_PROFILE=
AWS_REGION=us-east-1

# ---------------------------------------------------------------- LLM (Amazon Bedrock)
# mock: AWS'siz, kurallı · live: Bedrock'a gider · record: gider ve cassettes/ altına kaydeder · replay: kayıttan oynatır
CM_LLM_MODE=mock
# mantle (Bedrock Mantle) ya da invoke (Bedrock Runtime InvokeModel; çıkarım profili kimliği ister)
CM_BEDROCK_CLIENT=invoke
# Model: çıkarım profili biçiminde. Test ve demo için Sonnet/Haiku; Opus kredi tüketir.
CM_MODEL_ID=global.anthropic.claude-sonnet-5
# Ajan başına model (boşsa CM_MODEL_ID). Hafif ajanlar için Haiku yeterli.
CM_MODEL_ASSIGNMENT=
CM_MODEL_MEMORY=
CM_MODEL_BRIEFING=
CM_MODEL_ORCHESTRATOR=
CM_MODEL_HARVEST=
# Bedrock API anahtarı (isteğe bağlı; AWS kimliği yerine). Gizlidir: yalnız .env'de, asla repoda.
CM_BEDROCK_API_KEY=
# Otomatik prompt önbelleği (1/0)
CM_AUTO_CACHE=1
CM_CASSETTE_DIR=cassettes

# ---------------------------------------------------------------- Veri ve depolama
CM_RUN_DIR=data/demo_run
# file: yerel JSON dosyaları · dynamodb: AWS DynamoDB tablosu (deploy/dynamodb/create_table.py)
CM_STORAGE=file
CM_DYNAMODB_TABLE=courier-memory
# file modunda kullanılan dosyalar
CM_MEMORY_FILE=data/live_memory.json
CM_USAGE_LOG=data/usage.jsonl

# ---------------------------------------------------------------- Ses (Amazon Polly)
CM_POLLY=0
# tr-TR: Burcu (neural, varsayılan) | Filiz (standard). Motor boşsa sese göre seçilir.
CM_POLLY_VOICE=
CM_POLLY_ENGINE=

# ---------------------------------------------------------------- AgentCore dağıtımı (deploy/agentcore)
# AgentCore projesinin klasörü (varsayılan: reponun üst klasörü)
CM_WORKSPACE=
# 1: supervisor + 4 uzman runtime · 0: tek runtime
CM_MULTI_AGENT=1
CM_TARGET=default
# Runtime ajanlarının modeli (şablonun model/load.py yoksa)
CM_AGENT_MODEL_ID=global.anthropic.claude-sonnet-5

# ---------------------------------------------------------------- Dağıtılmış kaynaklar (referans; değerleri .env'de tutun)
# Geçici AWS kimliği kullanıyorsanız (ör. etkinlik hesabı). Tanımlıysa AWS_PROFILE yerine bunlar kullanılır. GİZLİ.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=
# Web (deploy/web/ecs_deploy.py)
WEB_URL=
ECS_CLUSTER=courier-memory
ECS_SERVICE=courier-memory-web
ECR_REPOSITORY_URI=
# AgentCore (deploy/agentcore; `aws bedrock-agentcore-control list-agent-runtimes`)
AGENTCORE_AGENT_RUNTIME_ARN=
AGENTCORE_PLANNER_RUNTIME_ARN=
AGENTCORE_COURIER_RUNTIME_ARN=
AGENTCORE_MEMORY_KEEPER_RUNTIME_ARN=
AGENTCORE_ANALYST_RUNTIME_ARN=
AGENTCORE_MEMORY_ARN=
# Athena (deploy/athena/athena_setup.py)
ATHENA_DATABASE=courier_memory
ATHENA_WORKGROUP=courier-memory
ATHENA_BUCKET=
# Amazon Quick köprüsü (deploy/quick/quick_bridge_setup.py yazar: ~/.courier-memory/quick-bridge.json). QUICK_CLIENT_SECRET GİZLİ.
QUICK_MCP_URL=
QUICK_CLIENT_ID=
QUICK_CLIENT_SECRET=
QUICK_TOKEN_URL=
QUICK_SCOPE=courier-memory/invoke
QUICK_GATEWAY_ID=
QUICK_LAMBDA_ARN=
QUICK_COGNITO_USER_POOL_ID=
# CI/CD (deploy/ci/github_oidc_setup.py)
GITHUB_DEPLOY_ROLE_ARN=
